# Template only — copy to .env and fill real values (this file is committed;
# do NOT put real passwords here).
# Postgres (shared instance, separate databases per consumer)
POSTGRES_USER=alps
POSTGRES_PASSWORD=change_me_dev
POSTGRES_APP_DB=alps_twin
POSTGRES_TEMPORAL_DB=temporal
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# host-side port; 5432 is taken by a local Homebrew Postgres on this machine
POSTGRES_HOST_PORT=5433

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=alps_minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=alps-artifacts
MINIO_ENDPOINT=minio:9000

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_ADMIN_PASSWORD=change_me_opensearch

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak
KEYCLOAK_REALM=alps-twin
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8081

# Temporal
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233

# AI Gateway (wired in M5, not used before that)
LITELLM_BASE_URL=https://litellm.wizbase.ai.kr
LITELLM_API_KEY=

# App
API_PORT=8000
WEB_PORT=5173
GATEWAY_PORT=8090
